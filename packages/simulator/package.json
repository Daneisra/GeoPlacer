{
  "name": "@geoplacer/simulator",
  "version": "0.0.0",
  "private": true,
  "description": "Local canvas and agent simulator for GeoPlacer tests (multi-agent runs happen only here).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b ../core && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@geoplacer/core": "0.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
