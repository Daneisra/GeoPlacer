# Windows batch files must keep CRLF line endings whatever the Git settings or a ZIP download
# (cmd.exe labels and goto are unreliable with LF only).
*.bat text eol=crlf
*.cmd text eol=crlf

# Generated browser assets use canonical LF on every platform.
public/geopixels-capture.js text eol=lf
public/geopixels-connector.user.js text eol=lf
