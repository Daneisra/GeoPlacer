{
  "name": "geoplacer",
  "version": "6.0.0-rc.1",
  "main": "dist/server.js",
  "type": "module",
  "author": "JinxTheCatto and luluwaffless",
  "license": "AGPL-3.0-only",
  "funding": "https://ko-fi.com/jinxthecat and https://ko-fi.com/luluwaffless",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prestart": "npm run build:packages --silent",
    "setup:windows": "node scripts/setup-windows.mjs",
    "start:reader": "node scripts/start-reader.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "predev": "npm run build:packages --silent",
    "dev": "concurrently --prefix-colors=blue,green --names=backend,frontend \"node --watch --env-file-if-exists=.env --import tsx src/server.ts\" \"npm run dev:frontend\"",
    "predev:backend": "npm run build:packages --silent",
    "dev:backend": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "build:connector": "node scripts/build-connector.mjs",
    "build": "npm run build:connector && npm run build:packages && tsc && cd frontend && npm run build",
    "build:backend": "npm run build:packages && tsc",
    "build:frontend": "cd frontend && npm run build",
    "build:packages": "tsc -b packages/core packages/simulator packages/adapters-node packages/engine-service",
    "build:watch": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:packages": "eslint packages --ext .ts",
    "lint:frontend": "cd frontend && npx eslint . --max-warnings 0",
    "typecheck:frontend": "cd frontend && npx tsc -b",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck:packages": "npm run typecheck --workspaces",
    "pretest": "npm run build:packages --silent",
    "test": "jest",
    "pretest:legacy": "npm run build:packages --silent",
    "test:legacy": "jest",
    "test:packages": "npm run test --workspaces",
    "test:all": "npm run typecheck:packages && npm run test:legacy && npm run test:packages",
    "check": "npm run build:packages && tsc --noEmit && npm run lint && npm run lint:packages && npm run lint:frontend && npm run typecheck:frontend && npm run test:all",
    "check:logged": "node scripts/run-logged.mjs check",
    "test:packages:logged": "node scripts/run-logged.mjs test:packages",
    "bench:progress": "node --expose-gc --import tsx packages/core/bench/progress.bench.ts",
    "bench:snapshot-read": "node --import tsx packages/core/bench/snapshot-read.bench.ts",
    "bench:resources": "node --import tsx packages/core/bench/resources.bench.ts",
    "bench:planner": "node --expose-gc --import tsx packages/core/bench/planner.bench.ts",
    "bench:planner-focus": "node --expose-gc --import tsx packages/core/bench/planner-focus.bench.ts",
    "bench:scheduler": "npm run build:packages && node --expose-gc --import tsx packages/simulator/bench/scheduler.bench.ts",
    "bench:responsiveness": "npm run build:packages && node --expose-gc --import tsx packages/engine-service/bench/responsiveness.bench.ts",
    "predemo": "npm run build:packages --silent",
    "demo": "node --env-file-if-exists=.env dist/server.js --demo",
    "backup": "npm run build:packages --silent && node packages/engine-service/dist/backup-cli.js backup",
    "backup:verify": "npm run build:packages --silent && node packages/engine-service/dist/backup-cli.js verify",
    "restore": "npm run build:packages --silent && node packages/engine-service/dist/backup-cli.js restore",
    "bench:journal": "npm run build:packages && node --expose-gc --import tsx packages/adapters-node/bench/journal.bench.ts",
    "journal:diagnose": "npm run build:packages --silent && node --import tsx packages/adapters-node/src/journal-cli.ts diagnose",
    "journal:repair": "npm run build:packages --silent && node --import tsx packages/adapters-node/src/journal-cli.ts repair",
    "bench:order-cache": "npm run build:packages && node --import tsx packages/adapters-node/bench/order-cache.bench.ts",
    "bench:reservations": "npm run build:packages && node --import tsx packages/adapters-node/bench/reservations.bench.ts",
    "bench:core": "node --expose-gc --import tsx packages/core/bench/geometry-colors.bench.ts",
    "bench:templates": "npm run build:packages && node --import tsx packages/adapters-node/bench/templates.bench.ts",
    "bench:strategies": "node --expose-gc --import tsx packages/core/bench/strategies.bench.ts",
    "bench:color-by-color": "node --expose-gc --import tsx packages/core/bench/color-by-color.bench.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "canvas": "^3.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "gradient-string": "^3.0.0",
    "impit": "0.5.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tough-cookie": "^6.0.0",
    "vite": "^8.0.9",
    "winston": "^3.11.0",
    "winston-transport": "^4.9.0",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.20.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/tough-cookie": "^4.0.5",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "concurrently": "^9.2.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
