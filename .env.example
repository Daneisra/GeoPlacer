# GeoPlacer local configuration template.
# - Copy this file to ".env" (start.bat does it automatically when .env is missing).
# - ".env" is local and ignored by Git: never commit it, never put secrets here.
# - Every variable is optional: missing, empty or invalid values fall back to the
#   defaults shown below (invalid values are reported in the startup log).

HOST="127.0.0.1" # 127.0.0.1 for localhost only, or 0.0.0.0 for all network interfaces

# Environment
NODE_ENV=production
# Log level: error, warn, info (default), http, debug
# LOG_LEVEL=info

# Frontend Configuration
FRONTEND_PORT=5173

# Backend Server Configuration
PORT=3000

# Local access protection
# Extra host names accepted in the Host header (anti DNS rebinding), comma-separated.
# localhost, 127.0.0.1, ::1 and the HOST address are always accepted.
# ALLOWED_HOSTS=
# Extra browser origins allowed to call the API, comma-separated ("*" = one label).
# Origins served from an accepted host name are always allowed.
# Default: http://localhost:*,http://127.0.0.1:*,chrome-extension://*
# ALLOWED_ORIGINS=

# Maximum JSON request body (a 2000x2000 template is ~11.4 MB in the worst case)
JSON_BODY_LIMIT=12mb

# Rate Limiting Configuration (all routes; the UI uses ~20 requests/minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# WebSocket Configuration
MAX_WS_CONNECTIONS=50
WS_PING_INTERVAL_MS=30000

# Server Lifecycle Configuration
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000

# WPlace API Configuration
WPLACE_BASE=https://backend.wplace.live

# Keep-Alive Configuration (inherited Wplace code)
# OFF by default in GeoPlacer: when enabled, it logs every stored account into
# Wplace on a timer (an automated access to a real service). Leave it off.
# LEGACY_KEEPALIVE=1
KEEP_ALIVE_INTERVAL_MS=3600000
